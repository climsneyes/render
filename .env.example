# [필수] Gemini API 키 (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# [필수] 국가법령정보센터 오픈API 인증키 (기본 제공 키 사용 가능)
LAW_API_OC=climsneys85

# [선택] 기본 AI 모델 지정
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# [선택] 오류 보고용 이메일 SMTP 설정 (비워둘 시 이메일 발송 비활성화)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

