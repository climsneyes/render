# [필수] Gemini API 키 (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# [필수] 국가법령정보센터 오픈API 인증키 (기본 제공 키 사용 가능)
LAW_API_OC=climsneys85

# [선택] 기본 AI 모델 지정
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# [선택] 오류 보고용 이메일 HTTP API 설정 (Render 클라우드 배포 시 포트 차단 없이 사용 가능, 추천)
# Resend (https://resend.com) 회원가입 후 발급받은 API Key (re_...)
RESEND_API_KEY=
# 또는 Brevo API Key
BREVO_API_KEY=

# [선택] 수신 관리자 이메일 (기본값: lsh4676@korea.kr)
EMAIL_RECEIVER=lsh4676@korea.kr

# [선택] 기존 SMTP 설정 (로컬 개발 환경용, 클라우드에서는 포트 차단으로 인해 작동하지 않을 수 있음)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=

